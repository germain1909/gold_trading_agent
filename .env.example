# =============================================================================
# Trading desk - environment template
#
#   1. cp .env.example .env
#   2. Fill in the values below (steps for each one are next to it)
#   3. Never commit .env - it is git-ignored. This file has names only, no values.
#
# Check your setup:
#   python -m desk.slack_notifier          # Slack bot token + channel
#   python -m desk.watcher NQ              # Topstep login + market stream (Ctrl+C to stop)
# =============================================================================


# -----------------------------------------------------------------------------
# Topstep (TopstepX / ProjectX Gateway API) - REQUIRED
# -----------------------------------------------------------------------------
# 1. Log in at topstepx.com -> Settings -> API -> subscribe to API access if needed
# 2. Create an API key and copy it into TOPSTEP_API_KEY
# 3. TOPSTEP_USERNAME is your TopstepX login username
TOPSTEP_USERNAME=
TOPSTEP_API_KEY=
TOPSTEP_BASE=https://api.topstepx.com
# TOPSTEP_MARKET_HUB=wss://rtc.topstepx.com/hubs/market


# -----------------------------------------------------------------------------
# Live trading - only needed to place real orders
# -----------------------------------------------------------------------------
# off    = paper only (safe default)
# dryrun = build each order and post it to Slack, but never send it
# true   = REAL orders on TOPSTEP_ACCOUNT_ID, for scenarios with "mode": "live"
#
# Before `true`:
#   - TopstepX Settings -> enable "Auto OCO Brackets" (every entry carries a stop and target)
#   - confirm automated trading is allowed on your account
#   - find the numeric account id (prints id, name, canTrade for each active account):
#     python -c "from topstep.client import TopstepClient; from desk.broker import LiveBroker as B; \
#       b = B.__new__(B); b.client = TopstepClient(); \
#       [print(a['id'], a['name'], a['canTrade']) for a in b._post('/api/Account/search', {'onlyActiveAccounts': True})['accounts']]"
LIVE_TRADING=off
TOPSTEP_ACCOUNT_ID=
LIVE_DAILY_LOSS=300              # stop new live entries after this much realized loss ($) for the day
# LIVE_MAX_TRADES=4              # live entries per day
# LIVE_MAX_SIZE=1                # contracts per live trade (hard-capped at 1 in desk/broker.py)
# LIVE_STOP_PAD_TICKS=4          # extra stop ticks until the fill, then the stop moves to the planned price


# -----------------------------------------------------------------------------
# Slack - alerts, commands (help, plan, add:, generate, chart, kill...) and plan PDFs
# -----------------------------------------------------------------------------
# 1. api.slack.com/apps -> Create New App -> From scratch -> pick your workspace
# 2. OAuth & Permissions -> Bot Token Scopes: chat:write, channels:history, files:write
# 3. Install to Workspace -> copy the "Bot User OAuth Token" (xoxb-...) into SLACK_BOT_TOKEN
# 4. Socket Mode -> enable -> create an App-Level Token with scope connections:write
#    -> copy it (xapp-...) into SLACK_APP_TOKEN
# 5. Event Subscriptions -> enable -> Subscribe to bot events: message.channels
# 6. Reinstall the app (needed after adding scopes)
# 7. Create the channel (e.g. #trades) and invite the bot: /invite @<your app>
# 8. Your member ID: Slack profile -> ... -> Copy member ID (U...). Only this user can
#    send commands; it is also @mentioned on entries and exits.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=#trades
SLACK_USER_ID=


# -----------------------------------------------------------------------------
# Claude (Anthropic API) - Slack `generate`/`add:`, the evening auto-plan, AI trade reviews
# -----------------------------------------------------------------------------
# 1. console.anthropic.com -> add billing credits
# 2. If your organization uses workspaces: Settings -> Workspaces -> create one
# 3. API Keys -> create a key INSIDE that workspace -> copy it (sk-ant-...)
ANTHROPIC_API_KEY=
# ANALYST_CLAUDE_MODEL=claude-opus-5-5
# ANALYST_CLAUDE_EFFORT=medium
# PLAN_AI_MODEL=claude-opus-5-5
# PLAN_AI_EFFORT=medium
# PLAN_DEFAULT_MODE=live         # mode for new scenarios from Claude; say "paper" in the idea to override
# AUTO_PLAN_TIME=17:15           # Sun-Thu ET time to auto-draft the next session's plan; "off" to disable


# -----------------------------------------------------------------------------
# Local model (LM Studio) - agents and the "Analyze (local)" button in the UI
# -----------------------------------------------------------------------------
# Install LM Studio, download the model, and start its local server (Developer tab).
# LM_STUDIO_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=qwen3-vl-8b-instruct-mlx


# -----------------------------------------------------------------------------
# Google Gemini - legacy, not used (the agents run on LM Studio)
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=FALSE


# -----------------------------------------------------------------------------
# Optional tuning - the defaults shown are what the code uses when unset
# -----------------------------------------------------------------------------
# Desk
# DESK_UI_PORT=8050
# DESK_CANDLE_MINUTES=30
# DESK_MIN_STRENGTH=wick         # weakest rejection that alerts: weak | wick | pattern
# DESK_DB_PATH=data/desk.db

# Paper / backtest risk
# RISK_MAX_PER_TRADE=250         # $ risk per trade
# RISK_MIN_CONTRACTS=1
# RISK_MAX_CONTRACTS=3
# RISK_MIN_RR=1.5
# RISK_TRADES_PER_SESSION=2
# RISK_DAILY_LOSS_LIMIT=1000
# RISK_LAST_ENTRY=15:30          # no new entries after this ET time
# RISK_STOP_BUFFER=2.0           # points beyond the wick
# RISK_LOCK_ROLL=false           # lock and roll at the target (experimental)

# Scenario detector
# BREAKOUT_STOP_ATR=0            # min breakout stop distance in 30m ATRs (tested worse; keep 0)
